    <body>
        <h1>LIST</h1>
        <p>There are two types of list</p>
        <h2>ORDERED LIST</h2>
        <ol>
            <li>Apple</li>
            <li>Ball<li>
            <li>Cat</li>
         </ol>
         <h2>Unordered List</h2>
         <ul>
            <li>One</li>
            <li>Two</li>
            <li>Three</li>
        </ul>
    </body>
